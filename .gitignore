# Dependencies
node_modules/
frontend/node_modules/
*/node_modules/

# Production build outputs
dist/
frontend/dist/
build/

# Python Virtual Environments & Bytecode
venv/
.venv/
env/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Local SQLite databases (prevent committing runtime databases)
*.db
backend/instance/*.db
instance/*.db
*.sqlite3

# Environment variables & secrets (CRITICAL: Do NOT commit secrets!)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# IDE, Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
