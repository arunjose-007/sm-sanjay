# Free Cloud AI: Groq Cloud API (100% Free - Get key at https://console.groq.com)
# Recommended for Vercel/Cloud Deployment: Powers DeepSeek R1, Llama 3.3 70B, Qwen 2.5, Gemma 2 at 300+ tok/s
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Free Cloud AI: Google Gemini API (100% Free tier - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter Free Models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key

# xAI Grok API Configuration (Paid credits required)
XAI_API_KEY=your_grok_api_key
XAI_MODEL=grok-2-latest

# Weather API (Optional - Open-Meteo works without keys)
WEATHER_API_KEY=your_weather_api_key

# Flask Server Settings
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=intelligent-assistant-secret-key-2026

# Local Database
DATABASE_URL=sqlite:///instance/livelihood_safety.db

# Offline Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Default Region (Tamil Nadu, India)
DEFAULT_LATITUDE=11.1271
DEFAULT_LONGITUDE=78.6569
DEFAULT_LOCATION_NAME=Tamil Nadu, India
